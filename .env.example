APP_NAME=SoundShelf
APP_ENV=development
DATABASE_URL=sqlite:///soundshelf.db
LOG_LEVEL=INFO
LOG_FILE=
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FFMPEG_PATH=ffmpeg
YT_DLP_TIMEOUT_SECONDS=30
TEMPORARY_FOLDER=.soundshelfTmp
TASK_WORKER_COUNT=3
TASK_POLL_INTERVAL_MS=1000
MAX_PAGE_SIZE=100
COMPARISON_HISTORY_LIMIT=3

# Electron define estos valores dinamicamente. No es necesario configurarlos
# para el desarrollo web normal.
# SOUNDSHELF_DATA_DIR=C:/ruta/de/datos
# SOUNDSHELF_FRONTEND_DIR=C:/ruta/al/build
# SOUNDSHELF_PORT=43125
